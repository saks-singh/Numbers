# /etc/bootbench/env  --  install with mode 0600, owner bootbench
#
#   install -d -m 0750 -o bootbench -g bootbench /etc/bootbench
#   install -m 0600 -o bootbench -g bootbench env.example /etc/bootbench/env
#
# Read by both systemd units. Secrets live here rather than in a config file
# so `git status` can never be the thing standing between a token and a
# public repo.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leaving this UNSET is the most secure option and is fully supported: an
# empty DSN makes libpq read PGHOST/PGUSER/PGDATABASE and ~/.pgpass, or use
# peer auth over the unix socket for a dedicated `bootbench` role. Then no
# password exists in any file this repo controls.
#
# BOOTBENCH_DB_DSN=postgresql:///bootbench

# ---------------------------------------------------------------------------
# Bench host agents
# ---------------------------------------------------------------------------
# Must match the token in the agent's own environment on the Windows host
# (set there via the Startup shortcut, NOT in agentconfig.json).
BOOTBENCH_AGENT_TOKEN=change-me

# Per-host override, for when two bench hosts have different tokens. The
# suffix is the hostname upper-cased with non-alphanumerics as underscores:
# http://bench-win-01:8765 -> BOOTBENCH_AGENT_TOKEN__BENCH_WIN_01
# BOOTBENCH_AGENT_TOKEN__BENCH_WIN_01=change-me

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# Required on every POST (trigger, cancel, acknowledge). Without it the web
# app refuses all of them -- GETs still work, so the dashboard is readable
# but not actionable.
BOOTBENCH_TRIGGER_TOKEN=change-me

# ---------------------------------------------------------------------------
# Alerting (optional; absent means no email, which is not an error)
# ---------------------------------------------------------------------------
# BOOTBENCH_SMTP_HOST=smtp.example.com
# BOOTBENCH_SMTP_PORT=587
# BOOTBENCH_SMTP_USER=bootbench@example.com
# BOOTBENCH_SMTP_PASSWORD=
# BOOTBENCH_NOTIFY_TO=boot-team@example.com
# BOOTBENCH_NOTIFY_WEBHOOK=
