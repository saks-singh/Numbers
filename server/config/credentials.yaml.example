# Copy to credentials.yaml (gitignored, chmod 0600) or set the environment
# variables instead -- every key here has an env fallback and the manager
# never raises, so a missing value is a warning plus None and the consumer
# decides whether that is fatal.
#
# Comma-separated strings, never YAML lists: the stdlib fallback parser
# cannot read lists.

# Postgres. Leaving this EMPTY is the preferred setup, not a fallback:
# an empty DSN makes libpq read PGHOST/PGUSER/~/.pgpass, which keeps the
# password out of this process entirely. Use peer auth over the unix
# socket for a dedicated `bootbench` role.
#   env: BOOTBENCH_DB_DSN
db_dsn: ""

# Required on every POST to the web app (manual trigger, cancel,
# acknowledge). Compared with hmac.compare_digest. GETs are unauthenticated.
#   env: BOOTBENCH_TRIGGER_TOKEN
trigger_token: ""

# Bearer token for the bench agents. One shared token is fine; for a
# different token per bench host, add a lowercased host-suffixed key:
#   agent_token__bench_win_01: "..."
#   agent_token__bench_win_02: "..."
# The env forms are BOOTBENCH_AGENT_TOKEN and BOOTBENCH_AGENT_TOKEN__BENCH_WIN_01.
# The agent itself reads its token from the environment only -- no secret is
# ever written to agentconfig.json.
#   env: BOOTBENCH_AGENT_TOKEN
agent_token: ""

# Alerting. Leave smtp_host empty to disable email entirely.
#   env: BOOTBENCH_SMTP_HOST / _PORT / _USER / _PASSWORD / _FROM
smtp_host: ""
smtp_port: 25
smtp_user: ""
smtp_password: ""
smtp_from: "bootbench@example.com"

# Comma-separated recipients.
#   env: BOOTBENCH_NOTIFY_TO
notify_to: ""

# Optional POST target for the same alerts (Teams/Slack incoming webhook).
#   env: BOOTBENCH_NOTIFY_WEBHOOK
notify_webhook: ""
